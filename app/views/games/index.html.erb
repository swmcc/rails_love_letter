<%= turbo_stream_from 'lobby' %>

<div class="w-full max-w-2xl mx-auto">
  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold">Lobby</h1>
    <div class="text-sm">
      Signed in as <strong><%= current_name %></strong>
      · <%= button_to 'Sign out', session_path, method: :delete, class: 'underline inline', form_class: 'inline' %>
    </div>
  </div>

  <div class="flex flex-wrap gap-3 items-center mb-6">
    <%= button_to 'Create Game', games_path, method: :post,
                  class: 'bg-emerald-600 text-white px-3 py-2 rounded hover:bg-emerald-700' %>

    <%= form_with url: code_games_path, method: :get, class: 'flex gap-2 items-center' do |f| %>
      <%= f.text_field :code, placeholder: 'Game code', maxlength: 6,
                       class: 'border p-2 rounded w-32 font-mono uppercase tracking-widest' %>
      <button class="bg-blue-600 text-white px-3 py-2 rounded hover:bg-blue-700">Join by code</button>
    <% end %>
  </div>

  <h2 class="font-semibold mb-2">Open games</h2>
  <% if @games.any? %>
    <ul class="space-y-2">
      <% @games.each do |g| %>
        <li class="p-3 bg-gray-100 rounded flex justify-between items-center">
          <span>
            Game #<%= g.id %> · Code <span class="font-mono font-bold"><%= g.code %></span>
            · Players <%= g.participants.count %>/<%= g.max_players || 4 %>
          </span>
          <%= link_to 'Open', g, class: 'underline' %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500">No open games — create one!</p>
  <% end %>
</div>
