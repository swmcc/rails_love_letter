<%= turbo_stream_from @game %>

<div class="w-full max-w-3xl mx-auto">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-xl font-bold">Love Letter · Game #<%= @game.id %></h1>
    <div class="flex items-center gap-2 text-sm" data-controller="clipboard">
      <span class="text-gray-600">Code</span>
      <code class="px-2 py-1 rounded bg-gray-100 font-mono font-bold tracking-widest" data-clipboard-target="source"><%= @game.code %></code>
      <button type="button" class="px-2 py-1 rounded border bg-white hover:bg-gray-50"
              data-action="clipboard#copy" data-clipboard-target="button">Copy</button>
    </div>
  </div>

  <% if @game.lobby? %>
    <%= render 'games/lobby', game: @game, me: @participant %>
  <% else %>
    <%= render 'games/board', game: @game, me: @participant %>
  <% end %>
</div>
